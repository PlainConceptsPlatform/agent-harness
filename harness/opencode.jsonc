{
  "$schema": "https://opencode.ai/config.json",
  // Third-party plugins load from npm. The local pc-* plugins under
  // .opencode/plugins/ are auto-discovered by OpenCode 2.
  //
  // @different-ai/opencode-browser is deliberately absent: it is a V1 plugin
  // and OpenCode 2 rejects it at load. Browser automation runs through the
  // agent-browser MCP server below.
  "plugins": [
    "@mohak34/opencode-notifier@1.1.0"
  ],
  "mcp": {
    "servers": {
      "agent-browser": {
        "type": "local",
        "command": ["agent-browser", "mcp", "--tools", "core"],
        "disabled": false
      }
    },
    "timeout": {
      "catalog": 300000,
      "execution": 300000
    }
  },
  "compaction": {
    "auto": true,
    "buffer": 10000
  },
  "permissions": [
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" }
  ],
  "skills": [".agents/skills"],
  "default_agent": "plan",
  "agents": {
    "build": { "mode": "primary" },
    "plan": {
      "mode": "primary",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
