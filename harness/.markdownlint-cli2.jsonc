{
  "config": {
    "default": false,
    "no-hard-wrapped-prose": true
  },
  "customRules": [".markdownlint-rules.cjs"],
  "ignores": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    // Harness-managed content: regenerated by `workflows update` / skill installs,
    // not yours to reflow. Ignoring it here is what keeps a fresh install green;
    // without it, ten wrapped paragraphs already shipped inside .agents/ and
    // .opencode/ would fail on day one with nothing the consumer can fix.
    ".agents/**",
    ".opencode/**"
  ]
}
