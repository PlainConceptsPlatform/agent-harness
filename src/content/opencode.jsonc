{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "plugin": [
    "@different-ai/opencode-browser@4.6.1",
    "@mohak34/opencode-notifier@0.2.8"
  ],
  "experimental": {
    "mcp_timeout": 300000
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "permission": {
    "question": "allow",
    "todowrite": "allow",
    "skill": {
      "ob-*": "allow",
      "openspec-*": "allow"
    }
  },
  "skills": {
    "paths": [".agents/skills"]
  },
  "default_agent": "fullstack-engineer",
  "agent": {
    "build": { "disable": true },
    "plan": { "disable": true }
  }
}
